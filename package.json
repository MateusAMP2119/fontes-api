{
  "name": "fontes-api",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev --remote --port 8788 --var BETTER_AUTH_URL:http://localhost:8788 GOOGLE_REDIRECT_URI:https://builder.fonteslabs.com/api/auth/callback/google",
    "build": "wrangler deploy --dry-run --outdir .wrangler/build",
    "typecheck": "wrangler types worker-configuration-auth.d.ts --env-interface AuthBindings && tsc -p worker/tsconfig.json",
    "deploy": "wrangler deploy",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "better-auth": "1.7.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "~6.0.2",
    "wrangler": "4.129.0"
  }
}
