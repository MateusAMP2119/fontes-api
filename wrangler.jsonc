{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fontes-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "api.fonteslabs.com",
      "custom_domain": true
    },
    {
      "pattern": "www.api.fonteslabs.com",
      "custom_domain": true
    },
    {
      "pattern": "builder.fonteslabs.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true
  },
  "d1_databases": [
    {
      "binding": "APP_DB",
      "database_name": "fontes-app",
      "database_id": "2d52f44f-e89a-487a-9149-94fb5ead9b32"
    },
    {
      "binding": "BRIEFING_DB",
      "database_name": "fontes-briefings",
      "database_id": "e7835801-3e72-4444-af20-6f8433369d9f",
      "migrations_dir": "briefing/migrations"
    }
  ],
  "send_email": [
    {
      "name": "AUTH_EMAIL",
      "allowed_sender_addresses": [
        "conta@fonteslabs.com"
      ]
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://api.fonteslabs.com",
    "GOOGLE_REDIRECT_URI": "https://builder.fonteslabs.com/api/auth/callback/google",
    "NEWS_API_URL": "https://fontes-api.bymarreco.com"
  },
  "limits": {
    "cpu_ms": 30000
  },
  "minify": true,
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.html"
      ],
      "fallthrough": true
    },
    {
      "type": "Data",
      "globs": [
        "**/*.png"
      ],
      "fallthrough": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "EMAIL_TEMPLATES",
      "bucket_name": "fontes-email-templates"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  }
}
