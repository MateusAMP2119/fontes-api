{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fontes-api-local",
  "main": "worker/local.ts",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "APP_DB",
      "database_name": "fontes-app",
      "database_id": "2ebddf0d-bb3f-4fee-8448-64306706035a",
      "remote": false
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "http://localhost:5173"
  },
  "minify": true
}
