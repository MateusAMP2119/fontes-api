{
  "openapi": "3.1.0",
  "info": {
    "title": "Fontes App API",
    "version": "0.1.2",
    "description": "Fontes API for authentication, organizations and projects. Auth endpoints are generated from the running Better Auth configuration. Browser sessions use HttpOnly cookies. Start Google login in the app so the browser retains its OAuth state cookie."
  },
  "servers": [
    {
      "url": "/",
      "description": "Current environment"
    }
  ],
  "tags": [
    {
      "name": "Service"
    },
    {
      "name": "Email"
    },
    {
      "name": "Google"
    },
    {
      "name": "Sessions"
    },
    {
      "name": "Organizations"
    },
    {
      "name": "Projects"
    }
  ],
  "paths": {
    "/api/auth/health": {
      "get": {
        "summary": "Check auth service readiness",
        "operationId": "get_api_auth_health",
        "tags": [
          "Service"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Worker and database are ready",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "ok"
                    },
                    "runtime": {
                      "const": "cloudflare-worker"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Auth is not configured"
          }
        }
      }
    },
    "/api/auth/organization-access/code": {
      "get": {
        "summary": "Get the active organization\u2019s temporary join code",
        "operationId": "get_api_auth_organization_access_code",
        "tags": [
          "Organizations"
        ],
        "security": [
          {
            "sessionCookie": []
          },
          {
            "secureSessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Verified owners/admins only; response contains id, name, slug, code and expiresAt",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "403": {
            "description": "Untrusted origin, unverified email, or insufficient access"
          },
          "429": {
            "description": "Request limit exceeded"
          },
          "401": {
            "description": "No valid session"
          }
        }
      }
    },
    "/api/auth/organization-access/join": {
      "post": {
        "summary": "Join an organization using its temporary code",
        "operationId": "post_api_auth_organization_access_join",
        "tags": [
          "Organizations"
        ],
        "security": [
          {
            "sessionCookie": []
          },
          {
            "secureSessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "403": {
            "description": "Untrusted origin, unverified email, or insufficient access"
          },
          "429": {
            "description": "Request limit exceeded"
          },
          "401": {
            "description": "No valid session"
          }
        },
        "description": "Send JSON from the same origin as the API. Browser requests include the Origin header automatically.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "pattern": "^[0-9]{4}$"
                  },
                  "name": {
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "code"
                ]
              }
            }
          }
        }
      }
    },
    "/api/projects": {
      "get": {
        "summary": "List visible projects in the active organization",
        "operationId": "get_api_projects",
        "tags": [
          "Projects"
        ],
        "security": [
          {
            "sessionCookie": []
          },
          {
            "secureSessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Public organization projects and the current user\u2019s private projects",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "403": {
            "description": "Untrusted origin, unverified email, or insufficient access"
          },
          "429": {
            "description": "Request limit exceeded"
          },
          "401": {
            "description": "No valid session"
          }
        }
      },
      "post": {
        "summary": "Create a project in the active organization",
        "operationId": "post_api_projects",
        "tags": [
          "Projects"
        ],
        "security": [
          {
            "sessionCookie": []
          },
          {
            "secureSessionCookie": []
          }
        ],
        "responses": {
          "201": {
            "description": "Created project",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "403": {
            "description": "Untrusted origin, unverified email, or insufficient access"
          },
          "429": {
            "description": "Request limit exceeded"
          },
          "401": {
            "description": "No valid session"
          }
        },
        "description": "Send JSON from the same origin as the API. Browser requests include the Origin header automatically.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "visibility": {
                    "type": "string",
                    "enum": [
                      "private",
                      "public"
                    ],
                    "default": "private"
                  }
                },
                "required": [
                  "name"
                ]
              }
            }
          }
        }
      }
    },
    "/api/briefing": {
      "get": {
        "tags": [
          "Briefing"
        ],
        "summary": "Read the saved general briefing",
        "description": "Requires a verified session. No query parameters or body. Reads serve the latest valid general briefing from D1 without invoking AI. Responses include text, linked segments, story labels, counts, period, generation_id, and model/prompt metadata.",
        "responses": {
          "200": {
            "description": "Saved or cached briefing."
          },
          "401": {
            "description": "Session required."
          },
          "403": {
            "description": "Verified email or trusted Origin required."
          },
          "404": {
            "description": "No briefing generated yet."
          },
          "409": {
            "description": "Generation in progress."
          },
          "502": {
            "description": "Source generation failed; prior snapshot preserved."
          },
          "503": {
            "description": "Briefing unavailable or not configured."
          },
          "400": {
            "description": "Parameters and request bodies are not supported."
          }
        },
        "security": [
          {
            "sessionCookie": []
          },
          {
            "secureSessionCookie": []
          }
        ]
      }
    },
    "/api/briefing/generate": {
      "post": {
        "tags": [
          "Briefing"
        ],
        "summary": "Generate a general briefing on request",
        "description": "Requires the server-held EBS_API_TOKEN bearer credential. Generates inside fontes-api with Gemma 4 for an explicit interval of at most 31 days. Exact interval results are reused from D1. Inputs, model response and usage are retained in generation history. No separate Worker or service binding.",
        "responses": {
          "200": {
            "description": "Saved or cached briefing."
          },
          "401": {
            "description": "Missing or invalid bearer token."
          },
          "404": {
            "description": "No briefing generated yet."
          },
          "409": {
            "description": "Generation in progress or brief failure cooldown. Retry-After header indicates when to retry."
          },
          "502": {
            "description": "Source generation failed; prior snapshot preserved."
          },
          "503": {
            "description": "Briefing unavailable or not configured."
          },
          "201": {
            "description": "New briefing generated and saved."
          },
          "400": {
            "description": "Missing or invalid explicit interval."
          }
        },
        "security": [
          {
            "briefingBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "from",
                  "until"
                ],
                "properties": {
                  "from": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "until": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "better-auth.session_token",
        "description": "Local HTTP session; managed by the browser."
      },
      "secureSessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Secure-better-auth.session_token",
        "description": "HTTPS session; managed by the browser."
      },
      "briefingBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Server-held EBS_API_TOKEN, retained during consolidation."
      }
    }
  }
}
