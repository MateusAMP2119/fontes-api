{
  "openapi": "3.1.0",
  "info": {
    "title": "Fontes App API",
    "version": "0.1.2",
    "description": "Authentication, onboarding, briefings and news rankings."
  },
  "servers": [
    {
      "url": "/",
      "description": "Current environment"
    }
  ],
  "tags": [
    {
      "name": "Onboarding"
    },
    {
      "name": "Briefing"
    },
    {
      "name": "Rankings"
    }
  ],
  "paths": {
    "/api/briefing": {
      "get": {
        "tags": [
          "Briefing"
        ],
        "summary": "Read cached briefing",
        "description": "Returns the latest cached briefing. Requires a verified session bearer token.",
        "responses": {
          "200": {
            "description": "Saved or cached briefing."
          },
          "401": {
            "description": "Missing, invalid, expired or revoked session bearer token."
          },
          "403": {
            "description": "Verified email required."
          },
          "404": {
            "description": "No briefing generated yet."
          },
          "409": {
            "description": "Generation in progress."
          },
          "502": {
            "description": "Source generation failed; prior snapshot preserved."
          },
          "503": {
            "description": "Briefing unavailable or not configured."
          },
          "400": {
            "description": "Parameters and request bodies are not supported."
          }
        },
        "security": [
          {
            "sessionBearer": []
          }
        ]
      }
    },
    "/api/briefing/generate": {
      "post": {
        "tags": [
          "Briefing"
        ],
        "summary": "Generate  new briefing",
        "description": "Generates a briefing for the requested interval, or returns its cached result. Requires a verified session bearer token.",
        "responses": {
          "200": {
            "description": "Saved or cached briefing."
          },
          "401": {
            "description": "Missing, invalid, expired or revoked session bearer token."
          },
          "404": {
            "description": "No briefing generated yet."
          },
          "409": {
            "description": "Generation in progress or brief failure cooldown. Retry-After header indicates when to retry."
          },
          "502": {
            "description": "Source generation failed; prior snapshot preserved."
          },
          "503": {
            "description": "Briefing unavailable or not configured."
          },
          "201": {
            "description": "New briefing generated and saved."
          },
          "400": {
            "description": "Missing or invalid explicit interval."
          },
          "403": {
            "description": "Verified email required."
          }
        },
        "security": [
          {
            "sessionBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "from",
                  "until"
                ],
                "properties": {
                  "from": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "until": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/onboarding": {
      "get": {
        "tags": [
          "Onboarding"
        ],
        "summary": "Read onboarding state",
        "security": [
          {
            "sessionBearer": []
          },
          {
            "sessionCookie": []
          },
          {
            "secureSessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response."
          },
          "400": {
            "description": "Invalid input."
          },
          "401": {
            "description": "Verified session required."
          },
          "403": {
            "description": "Trusted origin or workspace permission required."
          },
          "409": {
            "description": "Setup conflict."
          }
        }
      },
      "post": {
        "tags": [
          "Onboarding"
        ],
        "summary": "Save onboarding setup",
        "security": [
          {
            "sessionBearer": []
          },
          {
            "sessionCookie": []
          },
          {
            "secureSessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response."
          },
          "400": {
            "description": "Invalid input."
          },
          "401": {
            "description": "Verified session required."
          },
          "403": {
            "description": "Trusted origin or workspace permission required."
          },
          "409": {
            "description": "Setup conflict."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "operationId": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "slug": {
                    "type": "string"
                  },
                  "profileName": {
                    "type": "string"
                  },
                  "organizationId": {
                    "type": "string"
                  },
                  "profileImage": {
                    "type": "string"
                  },
                  "completed": {
                    "type": "boolean"
                  },
                  "changelog": {
                    "type": "boolean"
                  },
                  "daily": {
                    "type": "boolean"
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "operationId",
                  "revision",
                  "name",
                  "slug",
                  "profileName",
                  "completed",
                  "changelog",
                  "daily"
                ]
              }
            }
          }
        }
      }
    },
    "/api/onboarding/invite": {
      "post": {
        "tags": [
          "Onboarding"
        ],
        "summary": "Create or send an invitation",
        "security": [
          {
            "sessionBearer": []
          },
          {
            "sessionCookie": []
          },
          {
            "secureSessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response."
          },
          "400": {
            "description": "Invalid input."
          },
          "401": {
            "description": "Verified session required."
          },
          "403": {
            "description": "Trusted origin or workspace permission required."
          },
          "409": {
            "description": "Setup conflict."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "organizationId": {
                    "type": "string"
                  },
                  "email": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "email"
                  }
                },
                "required": [
                  "token",
                  "organizationId",
                  "email"
                ]
              }
            }
          }
        }
      }
    },
    "/api/onboarding/join": {
      "post": {
        "tags": [
          "Onboarding"
        ],
        "summary": "Accept an invitation",
        "security": [
          {
            "sessionBearer": []
          },
          {
            "sessionCookie": []
          },
          {
            "secureSessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response."
          },
          "400": {
            "description": "Invalid input."
          },
          "401": {
            "description": "Verified session required."
          },
          "403": {
            "description": "Trusted origin or workspace permission required."
          },
          "409": {
            "description": "Setup conflict."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "token"
                ]
              }
            }
          }
        }
      }
    },
    "/api/rankings": {
      "get": {
        "tags": [
          "Rankings"
        ],
        "summary": "Read top writers, categories and entities",
        "description": "General news rankings for an explicit half-open discovery period of at most 31 days. Requires a verified session bearer token. Writers include stored agency and newsroom bylines. Categories are publisher labels. Mentions count distinct summarized events with at least one article collected in the period, not literal mentions in articles. Each list is ordered by count descending, then numeric ID ascending. Responses are private and not cached. All response timestamps are Unix seconds. With sort=growth, entries include previous_count, growth_percent (null for no previous activity) and activity (24 equal-duration buckets in chronological order). Sort is growth descending with nulls last, then count descending, then ID. A summarized event is assigned to its earliest collected article within each period so its buckets sum to its count.",
        "security": [
          {
            "sessionBearer": []
          }
        ],
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "description": "Inclusive start. Whole-second RFC 3339 timestamp, matching briefing interval rules.",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "example": "2026-09-11T00:00:00Z"
          },
          {
            "name": "until",
            "in": "query",
            "required": true,
            "description": "Exclusive end, no later than now.",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "example": "2026-09-12T00:00:00Z"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 10
            },
            "description": "Maximum entries in each list."
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "count",
                "growth",
                "volume"
              ],
              "default": "count"
            },
            "description": "Growth compares the selected period with the preceding equal period, ranking globally before the limit. New entries with no baseline follow measured changes."
          }
        ],
        "responses": {
          "200": {
            "description": "Rankings and coverage totals. Empty lists mean no matching data.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "version",
                    "scope",
                    "timestamp_basis",
                    "generated_at",
                    "latest_discovery",
                    "period",
                    "totals",
                    "writers",
                    "categories",
                    "mentions"
                  ],
                  "properties": {
                    "version": {
                      "const": 1
                    },
                    "scope": {
                      "const": "general"
                    },
                    "timestamp_basis": {
                      "const": "discovered_at"
                    },
                    "generated_at": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "latest_discovery": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "period": {
                      "type": "object",
                      "required": [
                        "from",
                        "until"
                      ],
                      "properties": {
                        "from": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "until": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      }
                    },
                    "totals": {
                      "type": "object",
                      "required": [
                        "articles",
                        "events"
                      ],
                      "properties": {
                        "articles": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "events": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      }
                    },
                    "writers": {
                      "type": "array",
                      "maxItems": 50,
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "name",
                          "rank",
                          "count",
                          "unit"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "id": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          },
                          "name": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 1000
                          },
                          "rank": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 50
                          },
                          "count": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          },
                          "unit": {
                            "const": "articles"
                          },
                          "previous_count": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "growth_percent": {
                            "type": [
                              "number",
                              "null"
                            ],
                            "description": "Percentage change, rounded to one decimal; null if previous_count is zero."
                          },
                          "activity": {
                            "type": "array",
                            "minItems": 24,
                            "maxItems": 24,
                            "items": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "description": "Chronological equal-duration buckets summing to the current count."
                          }
                        }
                      }
                    },
                    "categories": {
                      "type": "array",
                      "maxItems": 50,
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "name",
                          "rank",
                          "count",
                          "unit"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "id": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          },
                          "name": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 1000
                          },
                          "rank": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 50
                          },
                          "count": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          },
                          "unit": {
                            "const": "articles"
                          },
                          "previous_count": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "growth_percent": {
                            "type": [
                              "number",
                              "null"
                            ],
                            "description": "Percentage change, rounded to one decimal; null if previous_count is zero."
                          },
                          "activity": {
                            "type": "array",
                            "minItems": 24,
                            "maxItems": 24,
                            "items": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "description": "Chronological equal-duration buckets summing to the current count."
                          }
                        }
                      }
                    },
                    "mentions": {
                      "type": "array",
                      "maxItems": 50,
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "name",
                          "rank",
                          "count",
                          "unit",
                          "kind",
                          "slug"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "id": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          },
                          "name": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 1000
                          },
                          "rank": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 50
                          },
                          "count": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          },
                          "unit": {
                            "const": "events"
                          },
                          "kind": {
                            "type": "string",
                            "enum": [
                              "person",
                              "org",
                              "location"
                            ]
                          },
                          "slug": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "maxLength": 1000
                          },
                          "previous_count": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "growth_percent": {
                            "type": [
                              "number",
                              "null"
                            ],
                            "description": "Percentage change, rounded to one decimal; null if previous_count is zero."
                          },
                          "activity": {
                            "type": "array",
                            "minItems": 24,
                            "maxItems": 24,
                            "items": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "description": "Chronological equal-duration buckets summing to the current count."
                          }
                        }
                      }
                    },
                    "sort": {
                      "description": "Present for growth or volume ordering.",
                      "enum": [
                        "growth",
                        "volume"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing, duplicate, unknown or invalid query parameters."
          },
          "401": {
            "description": "Missing, invalid, expired or revoked session bearer token."
          },
          "403": {
            "description": "Verified email required."
          },
          "405": {
            "description": "Only GET is supported."
          },
          "503": {
            "description": "API not configured or news service unavailable, timed out, rate limited or returned invalid data."
          }
        }
      }
    },
    "/api/onboarding/invitation": {
      "post": {
        "tags": [
          "Onboarding"
        ],
        "summary": "Review a workspace invitation without joining",
        "security": [
          {
            "sessionBearer": []
          },
          {
            "sessionCookie": []
          },
          {
            "secureSessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Validated invitation workspace and role",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "name",
                    "role"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "role": {
                      "type": "string",
                      "enum": [
                        "member"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input."
          },
          "401": {
            "description": "Verified session required."
          },
          "403": {
            "description": "Trusted origin or workspace permission required."
          },
          "409": {
            "description": "Setup conflict."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "token"
                ]
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "better-auth.session_token",
        "description": "Local HTTP session; managed by the browser."
      },
      "secureSessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Secure-better-auth.session_token",
        "description": "HTTPS session; managed by the browser."
      },
      "sessionBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Session token returned by sign-in."
      }
    }
  }
}
